{
	"name": "amicable",
	"description": "Amicable is the default theme for the Novaris Content Management System, providing a clean, minimal starting point for showcasing your site's content.",
	"version": "1.0.0",
	"author": "Benjamin Lu",
	"license": "GPL-2.0-or-later",
	"homepage": "https://novaris-dev.com/portfolio/amicable",
	"main": "resources/js/app.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/novaris-dev/amicable.git"
	},
	"bugs": {
		"url": "https://github.com/novaris-dev/amicable/issues"
	},
	"devDependencies": {
		"concurrently": "^10.0.5",
		"sass": "^1.93.3",
		"vite": "^7.2.1"
	},
	"scripts": {
		"build": "npm run prod && npm run export",
		"dev": "vite build --minify=false && concurrently \"npm:watch:vite\" \"npm:watch:novaris\"",
		"watch:vite": "vite build --watch --minify=false",
		"watch:novaris": "composer novaris export -- --watch --url=https://novarisframework.codestacks.cc",
		"prod": "vite build",
		"export": "node export-theme.js"
	}
}
